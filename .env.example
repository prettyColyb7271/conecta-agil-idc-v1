# Correo que recibe las solicitudes de registro (pendiente de confirmar con IDC)
NEXT_PUBLIC_CONTACTO_IDC=

# Modo demo (Vercel) o local (servidor local). Por defecto: demo.
NEXT_PUBLIC_MODO=demo

# Modo servidor/runtime. Debe coincidir con APP_MODE usado al compilar.
APP_MODE=demo

# Ruta local para base de datos, documentos y respaldos.
# Si se omite, se usa LOCALAPPDATA\ConectaAgil en Windows o ./local-data.
LOCAL_DATA_DIR=
