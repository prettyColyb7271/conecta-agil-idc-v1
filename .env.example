# Correo que recibe las solicitudes de registro (pendiente de confirmar con IDC)
NEXT_PUBLIC_CONTACTO_IDC=

# Modo demo (Vercel) o local (servidor local). Por defecto: demo.
NEXT_PUBLIC_MODO=demo

# Modo servidor/runtime. Debe coincidir con APP_MODE usado al compilar.
APP_MODE=demo

# Ruta local para base de datos, documentos y respaldos.
# Si se omite, se usa LOCALAPPDATA\ConectaAgil en Windows o ./local-data.
LOCAL_DATA_DIR=

# Clave hexadecimal de 32 bytes para cifrar secretos TOTP en SQLite.
# Obligatoria al vincular MFA; nunca la guardes en git.
MFA_ENCRYPTION_KEY=

# Roles opcionales que deben usar MFA además de admin_seguridad.
MFA_REQUIRED_ROLES=

# Correo. En pruebas usa file; en producción usa resend.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_TRANSPORT=file
PUBLIC_BASE_URL=http://localhost:3140
# Orígenes adicionales exactos, separados por comas (por ejemplo, para un túnel).
ALLOWED_ORIGINS=
